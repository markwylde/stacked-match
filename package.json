{
  "name": "stacked-match",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:boundary": "node scripts/check-core-boundary.mjs",
    "typecheck": "tsc -b --force",
    "icons": "node scripts/generate-app-icons.mjs",
