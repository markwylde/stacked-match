    "shot": "vite-node scripts/screenshot.ts"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.62.1",
    "typescript": "^5.6.3",
